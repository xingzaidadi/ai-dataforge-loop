# Copy these values into your local shell/profile or CI secret store.
# Do not commit real tokens, database passwords, cookies, or internal URLs.

MIFY_ENDPOINT=https://dify.example.com/api/v1/workflows/run
MIFY_HTTP_TOKEN=app-your-http-workflow-token
MIFY_SQL_TOKEN=app-your-sql-workflow-token
MIFY_HTTP_WORKFLOW_ID=your-http-workflow-id
MIFY_SQL_WORKFLOW_ID=your-sql-workflow-id
MIFY_USER=skill-runner

SCM_DB_URI=mysql+pymysql://user:password@db-host.example.internal:3306/test_db
SCM_COOKIE_URL=https://example.internal/tools/get-cookie
SCM_BASE_URL=https://example.internal/scm
BPM_APPROVE_URL=https://example.internal/bpm/approve

# Optional: multimodal/UI verification
DATAMAKE_UI_HEADLESS=true
DATAMAKE_EVIDENCE_DIR=evidence/runs
