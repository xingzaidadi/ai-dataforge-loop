{
  "stockOrg": "{{ stockOrg }}",
  "receiveFactoryId": "{{ receiveFactoryId }}",
  "specialApprove": 0,
  "materials": [
    {% for mat in materials %}
    {
      "description": "{{ mat.materialDesc }}",
      "pnCode": "{{ mat.pnCode }}",
      "purchaseOrg": "{{ purchaseOrg }}",
      "applicationNum": {{ mat.mpq | default(10000) | int }},
      "baseUom": "{{ mat.baseUom | default('PC', true) }}",
      "key": {{ loop.index }},
      "materialCode": "{{ mat.materialCode }}",
      "materialDesc": "{{ mat.materialDesc }}",
      "manufacturer": "{{ mat.manufacturer | default('未知', true) }}",
      "spCode": "{{ mat.spCode | default('', true) }}",
      "brand": "{{ mat.brand | default('未知', true) }}",
      {# label default 不能用 mat.materialDesc 拼接：Jinja default 实参急切求值，
         materialDesc 缺失即 UndefinedError；改用显式三元避免依赖缺失字段。 #}
      "label": "{{ mat.label if mat.label else (mat.materialCode ~ '(' ~ (mat.materialDesc | default('', true)) ~ ')') }}",
      "value": "{{ mat.value | default(mat.materialCode, true) }}",
      "catePathCode": "{{ mat.catePathCode | default('000.00.00', true) }}",
      "codeDescEn": "{{ mat.codeDescEn | default('Material', true) }}",
      "catePathName": "{{ mat.catePathName | default('物料', true) }}",
      "materialGroupCode": "{{ mat.materialGroupCode | default('R0000000', true) }}",
      "materialGroup": "{{ mat.materialGroup | default('物料', true) }}",
      "projects": "{{ mat.projects | default('', true) }}",
      "mgroup": {{ (mat.mgroup if mat.mgroup else {"code": "R0000000", "name": "物料"}) | tojson }},
      "mpq": "{{ mat.mpq | default('10', true) }}",
      "mpnSupplier": [
        {% for s in mat.mpnSupplier | default([]) %}
        {
          "supplierCode": "{{ s.supplierCode }}",
          "lt": "{{ s.lt | default('7', true) }}",
          "mpq": "{{ s.mpq | default('10', true) }}",
          "moq": "{{ s.moq | default('10', true) }}",
          "xmCode": "{{ s.xmCode if s.xmCode else mat.materialCode }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ],
      "cvpnCode": "{{ mat.cvpnCode if mat.cvpnCode else (mat.pnCode if mat.pnCode else mat.materialCode) }}",
      "inStatus": "-",
      "outStatus": "-",
      "stockStatus": "良品",
      "xmCode": "{{ mat.materialCode }}",
      "unit": "{{ mat.baseUom | default('PC') }}",
      "number": {{ mat.mpq | default(10000) | int }},
      {# 纯数字供应商码补零到 6 位；非数字（含字母）直接透传原值，
         避免 supplierCode|int 把 'abc' 静默转 0 → '000000' 造错单。 #}
      "supplierCode": "{{ '%06d' | format(supplierCode | int) if (supplierCode is not none and supplierCode | string | trim and (supplierCode | string | trim).isdigit()) else supplierCode }}",
      "receiveDate": 1884182400000,
      "isNew": 1,
      "supplierCodeOption": {"label": "{{ supplierCode }}-{{ supplierName | default('') }}", "value": "{{ supplierCode }}", "key": "{{ supplierCode }}"},
      "receiveDateTimeStamp": 1775000000000,
      "remarks": ""
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ],
  "projectCode": "{{ projectCode }}",
  "projectDesc": "",
  "trialStage": "{{ trialStage | default('P0', true) }}",
  "isSubmit": true,
  "purchaseReason": "{{ purchaseReason | default('14', true) }}",
  "materialCheckerList": {{ (materialCheckerList if materialCheckerList else ['kangtao']) | tojson }},
  "purchaseType": {{ purchaseType | default(4, true) }},
  "stageRemark": ""
}
