{#- SRM datacube scene/execute 请求体。
    优先使用 Python 侧按 sceneId 注入的真实骨架 sceneBody（含各场景特有的内嵌
    API 编排 + PO 已替换）；仅在缺骨架时回退到最小结构（仅够发出、无法真正建单）。 -#}
{%- if sceneBody %}
{{ sceneBody | safe }}
{%- else %}
{
  "taskId": {{ taskId | default(0, true) }},
  "sceneName": "{{ sceneName }}",
  "sceneInput": [
    {
      "apiId": 9983,
      "protocol": "http",
      "apiName": "SRM_PO查询",
      "apiVariables": [
        { "name": "erpNo", "id": 0, "type": 1, "value": "{{ poNo }}" }
      ],
      "order": 1
    }
  ],
  "sceneOutput": { "name": "ASN_NO", "id": 0, "type": 6 },
  "sceneId": {{ sceneId | default(0, true) }},
  "forCounter": 1,
  "executePerson": "{{ executePerson }}"
}
{%- endif %}
