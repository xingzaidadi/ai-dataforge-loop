# ZNB普通物料PRPO造单流程配置 v3
# 核心变化：新增物料元数据查询步骤（/mrp/material/ptc/exact）
name: ZNB普通物料PRPO造单
description: 查询物料元数据 → ASL校验 → 创建PR → PR审批 → 查合同 → PR转PO → PO审批 → 查ERP单号

inputs:
  stockOrg:       { label: 库存组织, required: true, example: "MI_IOT" }
  purchaseOrg:    { label: 采购组织, required: true, example: "2120" }
  supplierCode:   { label: 供应商编码, required: true, example: "108062" }
  materials:      { label: 物料列表, required: true, type: object, example: '{"materialCode1": "1710301000006A"}' }
  projectCode:    { label: 项目编码, required: false, example: "EcoOdmJdm20240708220947-EU" }
  shipLocCode:    { label: 发货地点, required: true, example: "129797" }

config:
  db_uri: "mysql+pymysql://isc_scm_test_wn:vKoc3jfIM2v4z4pPwruR6YaUpCOaHZep@ksc.test.mysql01.b2c.srv:3304/isc_scm_test"
  cookie_url: "https://toolskit.test.mi.com/datacube/getSCMCookie"
  scm_base: "https://scm.test.mioffice.cn"
  bpm_base: "https://bpm-infra.test.mioffice.cn/bpmtool/api/bpmThree/approve"

steps:
  - id: get_cookie
    action: http_call
    params:
      url: "{{config.cookie_url}}"
      method: GET
    extract:
      cookie: "$.body.data.result.cookie"
    on_error:
      message: "cookie获取失败，尝试联系管理员-刘四星"

  # ② 物料元数据
  - id: get_materials
    action: template
    template: "templates/get-materials-body.json.j2"
    context:
      stockOrg: "{{inputs.stockOrg}}"
      materials: "{{inputs.materials}}"

  - id: fetch_materials
    action: http_call
    params:
      url: "{{config.scm_base}}/mrp/material/ptc/exact"
      method: POST
      headers:
        Cookie: "{{steps.get_cookie.extracted.cookie}}"
      body: "{{steps.get_materials.output}}"
    extract:
      materials_data: "$.body.data.results"

  # ②c 过滤物料元数据，只保留用户指定的物料
  - id: filter_materials
    action: filter_collection
    source: "steps.fetch_materials.extracted.materials_data"
    match_field: "materialCode"
    input_ref: "inputs.materials"

  # ③ ASL校验
  - id: check_asl
    action: loop
    items: "{{inputs.materials}}"
    loop_var: mat_key
    steps:
      - id: check_one
        action: http_call
        params:
          url: "{{config.scm_base}}/mrp/purchase/material-supplier-relations/batch"
          method: POST
          headers:
            Cookie: "{{steps.get_cookie.extracted.cookie}}"
          body:
            moduleCode: "Purchase9"
            batch:
              - stockOrg: "{{inputs.stockOrg}}"
                xmCode: "{{inputs.materials[context.mat_key]}}"
        extract:
          code: "$.body.code"
          message: "$.body.message"

  # ④ 拼PR请求体
  - id: build_pr
    action: template
    template: "templates/znb-pr-body-v3.json.j2"
    context:
      stockOrg: "{{inputs.stockOrg}}"
      purchaseOrg: "{{inputs.purchaseOrg}}"
      supplierCode: "{{inputs.supplierCode}}"
      projectCode: "{{inputs.projectCode}}"
      materials: "{{steps.filter_materials.output}}"
      receiveFactoryId: ""

  # ⑤ 创建PR
  - id: create_pr
    action: http_call
    params:
      url: "{{config.scm_base}}/mrp/pr/ordinary"
      method: POST
      headers:
        Cookie: "{{steps.get_cookie.extracted.cookie}}"
      body: "{{steps.build_pr.output}}"
    extract:
      code: "$.body.code"
      message: "$.body.message"
    on_error:
      message: "{{steps.create_pr.extracted.message}}"

  - id: check_pr
    action: condition
    if: "{{steps.create_pr.extracted.code}} == '0'"
    then: query_pr_info
    else: END_PR_FAIL

  - id: query_pr_info
    action: sql_query
    wait: 5
    retry: {max: 8, interval_ms: 7000}
    params:
      db_uri: "{{config.db_uri}}"
      query: "SELECT p.purchase_no,p.business_key FROM m_purchase p JOIN m_purchase_item i ON p.purchase_no=i.purchase_no WHERE i.xm_code IN({{materials_sql_in}}) AND i.supplier_code='{{inputs.supplierCode}}' AND p.stock_org='{{inputs.stockOrg}}' AND p.status >= 10 ORDER BY p.id DESC LIMIT 1"
    extract:
      purchase_no: "$.rows[0].purchase_no"
      business_key: "$.rows[0].business_key"

  - id: approve_pr
    action: http_call
    params:
      url: "{{config.bpm_base}}?businessKey={{steps.query_pr_info.extracted.business_key}}"
      method: GET
    wait: 8
    retry: {max: 12, interval_ms: 6000}
    extract:
      code: "$.body.code"
    on_error:
      message: "PR审批报错，尝试联系管理员-刘四星"

  - id: query_items
    action: sql_query
    params:
      db_uri: "{{config.db_uri}}"
      query: >
        SELECT id,xm_code FROM m_purchase_item WHERE purchase_no='{{steps.query_pr_info.extracted.purchase_no}}'
    filter:
      field: xm_code
      source: inputs.materials
    extract:
      items: "$.rows"

  # ⑧ 查合同（通用）
  - id: query_contract
    action: loop
    items: "{{steps.query_items.extracted.items}}"
    loop_var: pr_item
    steps:
      - id: query_one_gfa
        action: sql_query
        params:
          db_uri: "{{config.db_uri}}"
          query: >
            SELECT gfa_no,gfa_row_no,material_code FROM m_purchase_srm_gfa WHERE gfa_enable=1 AND sp_code='{{inputs.supplierCode}}' AND material_code='{{context.pr_item.xm_code}}' AND purchase_org='{{inputs.purchaseOrg}}' AND unix_timestamp()*1000<price_end_date ORDER BY contract_date DESC LIMIT 1
        extract:
          gfa_no: "$.rows[0].gfa_no"
          gfa_row_no: "$.rows[0].gfa_row_no"
          material_code: "$.rows[0].material_code"
          pr_item_id: "{{context.pr_item.id}}"
    collect: contracts
    goto: build_prpo

  - id: build_prpo
    action: template
    template: "templates/prpo-params.json.j2"
    context:
      contracts: "{{collected.contracts}}"
      purchaseNo: "{{steps.query_pr_info.extracted.purchase_no}}"
      stockOrg: "{{inputs.stockOrg}}"
      supplierCode: "{{inputs.supplierCode}}"
      purchaseOrg: "{{inputs.purchaseOrg}}"

  - id: pr_to_po
    action: http_call
    params:
      url: "{{config.scm_base}}/mrp/purchase/prpo/generatePo"
      method: POST
      headers:
        Cookie: "{{steps.get_cookie.extracted.cookie}}"
      body: "{{steps.build_prpo.output}}"
    extract:
      code: "$.body.code"
      message: "$.body.message"
    on_error:
      message: "{{steps.pr_to_po.extracted.message}}"

  - id: check_po
    action: condition
    if: "{{steps.pr_to_po.extracted.code}} == '0'"
    then: query_po_info
    else: END_PO_FAIL

  - id: query_po_info
    action: sql_query
    params:
      db_uri: "{{config.db_uri}}"
      query: >
        SELECT DISTINCT po.business_key,po.purchase_order_no FROM m_purchase_order po INNER JOIN m_purchase_order_item poi ON po.id=poi.purchase_order_id WHERE poi.source_no='{{steps.query_pr_info.extracted.purchase_no}}' ORDER BY po.id DESC LIMIT 1
    extract:
      po_business_key: "$.rows[0].business_key"
      purchase_order_no: "$.rows[0].purchase_order_no"

  - id: approve_po
    action: http_call
    params:
      url: "{{config.bpm_base}}?businessKey={{steps.query_po_info.extracted.po_business_key}}"
      method: GET
    wait: 8
    retry: {max: 12, interval_ms: 6000}
    extract:
      code: "$.body.code"
    on_error:
      message: "PO审批报错，尝试联系管理员-刘四星"

  - id: query_erp
    action: sql_query
    wait: 5
    params:
      db_uri: "{{config.db_uri}}"
      query: >
        SELECT DISTINCT po.erp_purchase_order_no FROM m_purchase_order po INNER JOIN m_purchase_order_item poi ON po.id=poi.purchase_order_id WHERE poi.source_no='{{steps.query_pr_info.extracted.purchase_no}}' AND po.erp_purchase_order_no IS NOT NULL AND po.erp_purchase_order_no != '' ORDER BY po.id DESC LIMIT 1
    extract:
      erp_no: "$.rows[0].erp_purchase_order_no"

  - id: check_erp
    action: condition
    if: "{{steps.query_erp.extracted.erp_no}} != ''"
    then: SUCCESS
    else: repush_erp

  - id: repush_erp
    action: http_call
    params:
      url: "{{config.scm_base}}/mrp/purchase/prpo/repushPo"
      method: POST
      headers:
        Cookie: "{{steps.get_cookie.extracted.cookie}}"
      body:
        purchaseOrderNo: "{{steps.query_po_info.extracted.purchase_order_no}}"
        purchaseNo: "{{steps.query_pr_info.extracted.purchase_no}}"
    extract:
      erp_no: "$.body.erp_purchase_order_no"
    goto: check_erp

terminals:
  SUCCESS:
    type: success
    message: |
      🎉 造单成功！
      PR号: {{steps.query_pr_info.extracted.purchase_no}}
      PO号: {{steps.query_po_info.extracted.purchase_order_no}}
      ERP单号: {{steps.query_erp.extracted.erp_no}}

  END_PR_FAIL:
    type: error
    message: "PR创建失败: {{steps.create_pr.extracted.message}}"

  END_PO_FAIL:
    type: error
    message: "PO创建失败: {{steps.pr_to_po.extracted.message}}"
