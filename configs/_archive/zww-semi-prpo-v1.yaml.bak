# ZWW半成品PRPO造单流程配置
name: ZWW半成品PRPO造单
description: ZWW半成品场景 → 查询代工厂 → 创建PR → 查询PR/PO/ERP

# 用户输入
inputs:
  stockOrg:       { label: 库存组织, required: true, example: "MI_TV" }
  purchaseOrg:    { label: 采购组织, required: true, example: "1111" }
  supplierCode:   { label: 供应商编码, required: true, example: "133490" }
  materials:      { label: 物料列表, required: true, type: object, example: '{"materialCode1": "D430240000006"}' }
  projectCode:    { label: 项目编码, required: true, example: "MN110GL455" }
  shipLocCode:    { label: 发货地点, required: false, example: "143307" }

# 全局配置
config:
  db_uri: "mysql+pymysql://isc_scm_test_wn:vKoc3jfIM2v4z4pPwruR6YaUpCOaHZep@ksc.test.mysql01.b2c.srv:3304/isc_scm_test"
  cookie_url: "https://toolskit.test.mi.com/datacube/getSCMCookie"
  scm_base: "https://scm.test.mioffice.cn"
  bpm_base: "https://bpm-infra.test.mioffice.cn/bpmtool/api/bpmThree/approve"

steps:
  # ① 获取Cookie
  - id: get_cookie
    action: http_call
    params:
      url: "{{config.cookie_url}}"
      method: GET
    extract:
      cookie: "$.body.data.result.cookie"
    on_error:
      message: "cookie获取失败，尝试联系管理员-刘四星"

  # ② 前置校验：ASL匹配（遍历每个物料）
  - id: check_asl
    action: loop
    items: "{{inputs.materials}}"
    loop_var: mat_key
    steps:
      - id: check_one
        action: http_call
        params:
          url: "{{config.scm_base}}/mrp/purchase/material-supplier-relations/batch"
          method: POST
          headers:
            Cookie: "{{steps.get_cookie.extracted.cookie}}"
          body:
            moduleCode: "Purchase9"
            batch:
              - stockOrg: "{{inputs.stockOrg}}"
                xmCode: "{{inputs.materials[context.mat_key]}}"
        extract:
          code: "$.body.code"
          message: "$.body.message"

  # ③ 查询代工厂ID（如果提供了shipLocCode）
  - id: query_factory
    action: sql_query
    params:
      db_uri: "{{config.db_uri}}"
      query: >
        SELECT id FROM d_factory WHERE factory_code='{{inputs.shipLocCode}}' AND product_line='{{inputs.stockOrg}}' ORDER BY id DESC LIMIT 1
    extract:
      factory_id: "$.rows[0].id"

  # ④ 拼PR请求体
  - id: build_pr
    action: template
    template: "templates/zww-semi-pr-body.json.j2"
    context:
      factory_id: "{{steps.query_factory.extracted.factory_id}}"
      stockOrg: "{{inputs.stockOrg}}"
      purchaseOrg: "{{inputs.purchaseOrg}}"
      supplierCode: "{{inputs.supplierCode}}"
      projectCode: "{{inputs.projectCode}}"
      materials: "{{inputs.materials}}"

  # ⑤ 创建PR
  - id: create_pr
    action: http_call
    params:
      url: "{{config.scm_base}}/mrp/purchase/free"
      method: POST
      headers:
        Cookie: "{{steps.get_cookie.extracted.cookie}}"
      body: "{{steps.build_pr.output}}"
    extract:
      code: "$.body.code"
      message: "$.body.message"
    on_error:
      message: "{{steps.create_pr.extracted.message}}"

  # ⑥ 检查PR
  - id: check_pr
    action: condition
    if: "{{steps.create_pr.extracted.code}} == '0'"
    then: query_pr_no
    else: END_PR_FAIL

  # ⑦ 查询PRno
  - id: query_pr_no
    action: sql_query
    wait: 5
    params:
      db_uri: "{{config.db_uri}}"
      query: >
        SELECT mp.purchase_no, mp.business_key FROM m_purchase mp INNER JOIN m_purchase_item mpi ON mp.purchase_no = mpi.purchase_no WHERE mp.status >= 10 AND mp.stock_org = '{{inputs.stockOrg}}' AND mpi.xm_code IN ({{materials_sql_in}}) ORDER BY mp.id DESC LIMIT 1
    extract:
      purchase_no: "$.rows[0].purchase_no"
      business_key: "$.rows[0].business_key"

  # ⑧ PR审批
  - id: approve_pr
    action: http_call
    params:
      url: "{{config.bpm_base}}?businessKey={{steps.query_pr_no.extracted.business_key}}"
      method: GET
    retry: {max: 10, interval_ms: 445}
    extract:
      code: "$.body.code"
    on_error:
      message: "PR审批报错，尝试联系管理员-刘四星"

  # ⑨ 查询PO号
  - id: query_po_no
    action: sql_query
    wait: 10
    params:
      db_uri: "{{config.db_uri}}"
      query: >
        SELECT DISTINCT po.business_key, po.purchase_order_no FROM m_purchase_order po INNER JOIN m_purchase_order_item poi ON po.id = poi.purchase_order_id WHERE poi.source_no = '{{steps.query_pr_no.extracted.purchase_no}}' LIMIT 1
    extract:
      purchase_order_no: "$.rows[0].purchase_order_no"
      po_business_key: "$.rows[0].business_key"

  # ⑩ PO审批
  - id: approve_po
    action: http_call
    params:
      url: "{{config.bpm_base}}?businessKey={{steps.query_po_no.extracted.po_business_key}}"
      method: GET
    retry: {max: 3, interval_ms: 100}
    extract:
      code: "$.body.code"
    on_error:
      message: "PO审批报错，尝试联系管理员-刘四星"

  # ⑪ 等5秒查ERP单号
  - id: query_erp
    action: sql_query
    wait: 5
    params:
      db_uri: "{{config.db_uri}}"
      query: >
        SELECT DISTINCT po.erp_purchase_order_no FROM m_purchase_order po INNER JOIN m_purchase_order_item poi ON po.id = poi.purchase_order_id WHERE poi.source_no = '{{steps.query_pr_no.extracted.purchase_no}}' AND po.erp_purchase_order_no IS NOT NULL AND po.erp_purchase_order_no != '' ORDER BY po.id DESC LIMIT 1
    extract:
      erp_no: "$.rows[0].erp_purchase_order_no"

  # ⑫ 判断ERP单号
  - id: check_erp
    action: condition
    if: "{{steps.query_erp.extracted.erp_no}} != ''"
    then: SUCCESS
    else: repush_erp

  # ⑬ 重新推送
  - id: repush_erp
    action: http_call
    params:
      url: "{{config.scm_base}}/mrp/purchase/prpo/repushPo"
      method: POST
      headers:
        Cookie: "{{steps.get_cookie.extracted.cookie}}"
      body:
        purchaseOrderNo: "{{steps.query_po_no.extracted.purchase_order_no}}"
        purchaseNo: "{{steps.query_pr_no.extracted.purchase_no}}"
    extract:
      erp_no: "$.body.erp_purchase_order_no"
    goto: check_erp

# 终止节点
terminals:
  SUCCESS:
    type: success
    message: |
      🎉 造单成功！
      PR号: {{steps.query_pr_no.extracted.purchase_no}}
      PO号: {{steps.query_po_no.extracted.purchase_order_no}}
      ERP单号: {{steps.query_erp.extracted.erp_no}}

  END_PR_FAIL:
    type: error
    message: "PR创建失败: {{steps.create_pr.extracted.message}}"
